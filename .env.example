# Supabase project → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Supabase is retiring the "anon" key
# name for this — a legacy anon key value still works here too, it's just
# the older naming.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (sb_secret_...; a legacy service_role key value
# also works). Bypasses Row Level Security — never expose to the browser,
# never commit a real value, never log it. Used only for trusted
# server-side admin actions (e.g. inviting a user via
# supabase.auth.admin.inviteUserByEmail).
SUPABASE_SECRET_KEY=

# Used to build the link inside magic-link/invite emails. Set this to your
# real deployed URL in production — deliberately not derived from request
# headers, which a client can spoof.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional notifications (organizer submitted, new message).
# Auth rate-limit errors require hosted SMTP configuration; setting this key
# does not change Supabase Auth's sender. See docs/AUTH-EMAIL-SETUP.md.
# Separate from Supabase Auth emails. Get a key at resend.com; the app
# retains notifications in the inbox and email queue until configured.
RESEND_API_KEY=
# "Name <verified-address@yourdomain.com>" once you've verified a domain
# in Resend. Required; there is no fallback sender.
EMAIL_FROM=

# Secret bearer token for POST /api/notifications/dispatch (scheduled retries).
NOTIFICATION_CRON_SECRET=
