# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose to the browser,
# never commit a real value, never log it. Used only for trusted server-side
# admin actions (e.g. inviting a user via supabase.auth.admin.inviteUserByEmail).
SUPABASE_SERVICE_ROLE_KEY=
